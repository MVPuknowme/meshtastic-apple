        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しい無線機に接続すると、電話上の全てのアプリデータがクリアされます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
