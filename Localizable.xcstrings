    "Connecting to a new radio will clear all app data on the phone." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connessione a un nuovo dispositivo cancellerà tutti i dati dell'applicazione sul telefono."
          }
