    "Enables automatic TAK PLI broadcasts and reduces routine broadcasts." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiviert automatische TAK-PLI-Übertragungen und verringert die Anzahl der Routineübertragungen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enables automatic TAK PLI broadcasts and reduces routine broadcasts."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enables automatic TAK PLI broadcasts and reduces routine broadcasts."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abilita le trasmissioni automatiche di TAK PLI e riduce le trasmissioni di routine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動TAK PLIブロードキャストを有効にし、定期ブロードキャストを削減します。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
